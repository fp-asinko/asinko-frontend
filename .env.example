# Copy to .env.local and fill in. Never commit real values (docs/ai-guidelines/security.md).

# development | preview | production. Controls indexing and whether mocks are allowed.
APP_ENV=development

# Public URL of this site (metadataBase, canonical, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base URL of the asinko-app backend. Development uses its Vercel deploy; to run asinko-app on
# your machine instead, http://localhost:3001.
API_BASE_URL=https://asinko-app-web.vercel.app

# Mocks (forbidden in production; api-integration.md § Mocks):
#   true    = every registered route from src/mocks/, with the demo user (no backend needed)
#   missing = only the routes the backend does not have yet (achievements, widgets, "open to",
#             tags): the DEV environment uses it against the dev backend
#   false   = no mocks
API_MOCKS=true

# Optional. How long a backend request may take, in ms (default 10000). Raise it only in
# development against a slow backend, e.g. a database in another continent.
API_TIMEOUT_MS=

# Optional. Without a DSN, Sentry stays off.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Supabase Auth (specs/auth): log in and sign up. The project asinko-app uses and its public (anon)
# key, the values asinko-app calls NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY. Here they
# are server-only: the browser never talks to Supabase. Required in production; optional elsewhere
# (without them, logging in says it is unavailable; with API_MOCKS=true a simulated Supabase answers,
# demo@asinko.dev / demo-password). Never the service_role key.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional, development only (specs/dev-login): a "Dev login" button in the top bar signs in with
# this test account in one tap. Needs SUPABASE_URL and SUPABASE_ANON_KEY. Create the account with
# the site's own Sign up. Forbidden in production.
DEV_LOGIN_EMAIL=
DEV_LOGIN_PASSWORD=
